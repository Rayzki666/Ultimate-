{
  "intro": "这份问卷是给她填的。把手机递过去，或者你念、她答。填完会生成一张只属于你们俩的「拍摄说明书」，之后这个 App 给的每一条建议都会按她的答案来调。",
  "outro": "填完了。别把这当成一份需求文档——它更像是一次你们本来就该聊的天。",
  "questions": [
    {
      "id": "goal",
      "q": "你最想要什么样的照片？",
      "hint": "没有标准答案，选那个更接近的。",
      "type": "single",
      "options": [
        { "v": "look",  "t": "我在照片里看起来好看" },
        { "v": "story", "t": "有回忆感、有故事，人自然就行" },
        { "v": "both",  "t": "两样都要，但先保证好看" }
      ]
    },
    {
      "id": "gaze",
      "q": "你更喜欢哪一种？",
      "hint": "",
      "type": "single",
      "options": [
        { "v": "camera", "t": "看着镜头的" },
        { "v": "candid", "t": "不看镜头、我不知道在拍的抓拍" },
        { "v": "mix",    "t": "两种都要一些" }
      ]
    },
    {
      "id": "framing",
      "q": "你最想要哪种画面？",
      "hint": "可以多选。",
      "type": "multi",
      "options": [
        { "v": "full",  "t": "全身" },
        { "v": "half",  "t": "半身" },
        { "v": "close", "t": "脸部特写" },
        { "v": "wide",  "t": "有环境的远景，人小一点" }
      ]
    },
    {
      "id": "worry",
      "q": "照片里你最介意什么？",
      "hint": "可以多选。说出来他才知道该避开什么。",
      "type": "multi",
      "options": [
        { "v": "face",  "t": "脸显大" },
        { "v": "fat",   "t": "显胖" },
        { "v": "legs",  "t": "腿显短" },
        { "v": "chin",  "t": "双下巴" },
        { "v": "stiff", "t": "表情僵、笑得假" },
        { "v": "hair",  "t": "头发乱、衣服没整理" },
        { "v": "bg",    "t": "背景乱、有杂物路人" },
        { "v": "eyes",  "t": "眼睛小、没精神" },
        { "v": "nomakeup", "t": "没化妆的时候被拍" }
      ]
    },
    {
      "id": "prep",
      "q": "拍之前，你希望他做什么？",
      "hint": "可以多选。",
      "type": "multi",
      "options": [
        { "v": "tidy",    "t": "提醒我整理一下头发和衣服" },
        { "v": "tell",    "t": "先告诉我要拍什么、站哪儿" },
        { "v": "preview", "t": "先拍一张给我看，我确认了再继续" },
        { "v": "nothing", "t": "什么都别说，直接拍" }
      ]
    },
    {
      "id": "volume",
      "q": "你希望他拍多少张？",
      "hint": "",
      "type": "single",
      "options": [
        { "v": "few",  "t": "少而精，三五张就够" },
        { "v": "many", "t": "多拍，我自己慢慢挑" },
        { "v": "depends", "t": "看情况" }
      ]
    },
    {
      "id": "public",
      "q": "在人多的地方被拍，你介意吗？",
      "hint": "",
      "type": "single",
      "options": [
        { "v": "yes",  "t": "很介意，会很不自在" },
        { "v": "some", "t": "有一点，看场合" },
        { "v": "no",   "t": "不介意" }
      ]
    },
    {
      "id": "duo",
      "q": "你们俩的合照，你想要什么样的？",
      "hint": "可以多选。这一题是这份问卷真正想问的。",
      "type": "multi",
      "options": [
        { "v": "tripod",  "t": "把手机架起来、正经拍的合照" },
        { "v": "selfie",  "t": "随手自拍就行" },
        { "v": "noface",  "t": "不用露脸的——牵手、影子、背影" },
        { "v": "family",  "t": "带孩子的三人照" },
        { "v": "ask",     "t": "找人帮我们拍" }
      ]
    },
    {
      "id": "after",
      "q": "拍完之后，你希望他怎么处理？",
      "hint": "",
      "type": "single",
      "options": [
        { "v": "raw",    "t": "原图直接发我，我自己挑" },
        { "v": "picked", "t": "他先挑几张好的给我" },
        { "v": "together", "t": "一起挑" },
        { "v": "edited", "t": "他修好了再给我" }
      ]
    },
    {
      "id": "free",
      "q": "还有什么想跟他说的？",
      "hint": "比如：你觉得他拍得最好的一张是哪张，好在哪儿；或者哪次拍照让你不舒服。",
      "type": "text"
    }
  ]
}
